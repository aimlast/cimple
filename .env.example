# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-...

# PostgreSQL Database (Railway provides this automatically if you add a PostgreSQL plugin)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Node environment
NODE_ENV=production

# Support mailbox shown on /broker/support (build-time, inlined by Vite).
# Optional — defaults to support@cimple.ca.
# VITE_SUPPORT_EMAIL=support@cimple.ca
